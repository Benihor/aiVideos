# Copy this file to .env and fill in your keys.
#
# Pixabay alone is enough (recommended right now):
#   1. Sign up / log in at https://pixabay.com/api/docs/
#   2. Your API key is shown on that page after login
#   3. Paste it below
#
# Pexels is optional. New Pexels API keys are currently paused.
#   https://www.pexels.com/api/

PIXABAY_API_KEY=
PEXELS_API_KEY=
